/dts-v1/;

#include "eliza-retroidpocket-common.dtsi"

/ {
	model = "RetroidPocket Duo";
	compatible = "retroidpocket,rpduo", "qcom,eliza";

	vdd_disp_s_1v8: vdd-disp-s-1v8-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vdd_disp_s_1v8";

		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <233>;

		gpio = <&tlmm 69 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vdd_disp_s_3v0: vdd-disp-s-3v0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vdd_disp_s_3v0";

		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-enable-ramp-delay = <233>;

		gpio = <&tlmm 70 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vdd_ts_p_1v8: vdd-ts-p-1v8-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vdd_ts_p_1v8";

		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		gpio = <&tlmm 74 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		vin-supply = <&vreg_l8b>;
	};

	vdd_ts_s_1v8: vdd-ts-s-1v8-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vdd_ts_s_1v8";

		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		gpio = <&tlmm 71 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vdd_ts_s_3v0: vdd-ts-s-3v0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vdd_ts_s_3v0";

		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;

		gpio = <&tlmm 72 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&gpu_zap_shader {
	firmware-name = "qcom/eliza/retroidpocket/rpduo/gen71700_zap.mbn";
};

&i2c6 {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@38 {
		label = "bottom_touchscreen";
		compatible = "focaltech,ft5452";
		reg = <0x38>;
		#address-cells = <1>;
		#size-cells = <0>;

		interrupt-parent = <&tlmm>;
		interrupts = <123 IRQ_TYPE_EDGE_FALLING>;

		reset-gpios = <&tlmm 124 GPIO_ACTIVE_LOW>;

		vcc-supply = <&vdd_ts_s_3v0>;
		iovcc-supply = <&vdd_ts_s_1v8>;

		pinctrl-0 = <&ts_s_rst_default &ts_s_int_default>;
		pinctrl-1 = <&ts_s_rst_sleep &ts_s_int_sleep>;
		pinctrl-names = "default", "sleep";

		touchscreen-size-x = <1280>;
		touchscreen-size-y = <960>;
	};
};

&i2c8 {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@38 {
		label = "top_touchscreen";
		compatible = "focaltech,ft5452";
		reg = <0x38>;
		#address-cells = <1>;
		#size-cells = <0>;

		interrupt-parent = <&tlmm>;
		interrupts = <13 IRQ_TYPE_EDGE_FALLING>;

		reset-gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;

		vcc-supply = <&vreg_l22b>;
		iovcc-supply = <&vdd_ts_p_1v8>;

		pinctrl-0 = <&ts_p_rst_default &ts_p_int_default>;
		pinctrl-1 = <&ts_p_rst_sleep &ts_p_int_sleep>;
		pinctrl-names = "default", "sleep";

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <1920>;
		touchscreen-inverted-y;
	};
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l4b>;

	status = "okay";

	panel@0 {
		compatible = "retroidpocket,rpduo-panel-top";
		reg = <0>;

		reset-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;

		vci-supply = <&vreg_l19b>;
		vdd-supply = <&vreg_l1g>;
		vddio-supply = <&vreg_l8b>;

		pinctrl-0 = <&dsi_p_rst_n_active>, <&dsi_p_te>;
		pinctrl-1 = <&dsi_p_rst_n_suspend>, <&dsi_p_te>;
		pinctrl-names = "default", "sleep";

		rotation = <270>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l2b>;

	status = "okay";
};

&mdss_dsi1 {
	vdda-supply = <&vreg_l4b>;

	status = "okay";

	panel@0 {
		compatible = "retroidpocket,rpduo-panel-bottom";
		reg = <0>;

		reset-gpios = <&tlmm 73 GPIO_ACTIVE_LOW>;

		vci-supply = <&vdd_disp_s_3v0>;
		vdd-supply = <&vreg_l1g>;
		vddio-supply = <&vdd_disp_s_1v8>;

		pinctrl-0 = <&dsi_s_rst_n_active>, <&dsi_s_te>;
		pinctrl-1 = <&dsi_s_rst_n_suspend>, <&dsi_s_te>;
		pinctrl-names = "default", "sleep";

		port {
			panel1_in: endpoint {
				remote-endpoint = <&mdss_dsi1_out>;
			};
		};
	};
};

&mdss_dsi1_out {
	remote-endpoint = <&panel1_in>;
	data-lanes = <0 1 2 3>;
	qcom,te-source = "mdp_vsync_s";
};

&mdss_dsi1_phy {
	vdds-supply = <&vreg_l2b>;

	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/eliza/retroidpocket/rpduo/adsp.mbn",
			"qcom/eliza/retroidpocket/rpduo/adsp_dtb.mbn";
};

&remoteproc_cdsp {
	firmware-name = "qcom/eliza/retroidpocket/rpduo/cdsp.mbn",
			"qcom/eliza/retroidpocket/rpduo/cdsp_dtb.mbn";
};

&remoteproc_wpss {
	firmware-name = "qcom/eliza/retroidpocket/rpduo/wpss.mbn";
};

&spk_amp_l {
	firmware-name = "qcom/eliza/retroidpocket/rpduo/aw883xx_acf.bin";
};

&spk_amp_r {
	firmware-name = "qcom/eliza/retroidpocket/rpduo/aw883xx_acf.bin";
};

&tlmm {
	dsi_p_rst_n_active: dsi-p-rst-n-active-state {
		pins = "gpio12";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	dsi_p_rst_n_suspend: dsi-p-rst-n-suspend-state {
		pins = "gpio12";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	dsi_p_te: dsi-p-te-state {
		pins = "gpio17";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	dsi_s_rst_n_active: dsi-s-rst-n-active-state {
		pins = "gpio73";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	dsi_s_rst_n_suspend: dsi-s-rst-n-suspend-state {
		pins = "gpio73";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	dsi_s_te: dsi-s-te-state {
		pins = "gpio121";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	ts_p_rst_default: ts-p-rst-default-state {
		pins = "gpio16";
		function = "gpio";
		bias-pull-up;
		drive-strength = <8>;
	};

	ts_p_rst_sleep: ts-p-rst-sleep-state {
		pins = "gpio16";
		function = "gpio";
		bias-pull-down;
		drive-strength = <2>;
	};

	ts_p_int_default: ts-p-int-default-state {
		pins = "gpio13";
		function = "gpio";
		bias-pull-up;
		drive-strength = <8>;
	};

	ts_p_int_sleep: ts-p-int-sleep-state {
		pins = "gpio13";
		function = "gpio";
		bias-pull-down;
		drive-strength = <2>;
	};

	ts_s_rst_default: ts-s-rst-default-state {
		pins = "gpio124";
		function = "gpio";
		bias-pull-up;
		drive-strength = <8>;
	};

	ts_s_rst_sleep: ts-s-rst-sleep-state {
		pins = "gpio124";
		function = "gpio";
		bias-pull-down;
		drive-strength = <2>;
	};

	ts_s_int_default: ts-s-int-default-state {
		pins = "gpio123";
		function = "gpio";
		bias-pull-up;
		drive-strength = <8>;
	};

	ts_s_int_sleep: ts-s-int-sleep-state {
		pins = "gpio123";
		function = "gpio";
		bias-pull-down;
		drive-strength = <2>;
	};
};
